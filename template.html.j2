<title>Drop-off Recovery Desk</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    color-scheme: light;
    --bg: #F4F7F7;
    --surface: #FFFFFF;
    --surface-2: #EAF1F0;
    --surface-chart: #FCFCFB;
    --border: #D7E1E0;
    --text: #101817;
    --text-secondary: #4B5B59;
    --text-muted: #7C8B89;
    --accent: #0F7C78;
    --accent-strong: #0B5F5C;
    --accent-soft: #DCEEEC;
    --good: #0ca30c;
    --warning: #b8720f;
    --critical: #b3423e;
    --cat-1: #2a78d6;
    --cat-2: #eb6834;
    --cat-3: #1baf7a;
    --cat-4: #eda100;
    --cat-5: #e87ba4;
    --cat-6: #008300;
    --shadow: 0 1px 2px rgba(16,24,23,0.04), 0 8px 24px -12px rgba(16,24,23,0.12);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      color-scheme: dark;
      --bg: #0D1413;
      --surface: #141E1D;
      --surface-2: #1A2625;
      --surface-chart: #121B1A;
      --border: #283634;
      --text: #ECF2F1;
      --text-secondary: #AEC0BD;
      --text-muted: #7E938F;
      --accent: #3FCFC6;
      --accent-strong: #5FDCD4;
      --accent-soft: #163431;
      --good: #3fbf3f;
      --warning: #e0a542;
      --critical: #e07a72;
      --cat-1: #3987e5;
      --cat-2: #d95926;
      --cat-3: #199e70;
      --cat-4: #c98500;
      --cat-5: #d55181;
      --cat-6: #3fbf3f;
      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);
    }
  }
  :root[data-theme="dark"]{
    color-scheme: dark;
    --bg: #0D1413;
    --surface: #141E1D;
    --surface-2: #1A2625;
    --surface-chart: #121B1A;
    --border: #283634;
    --text: #ECF2F1;
    --text-secondary: #AEC0BD;
    --text-muted: #7E938F;
    --accent: #3FCFC6;
    --accent-strong: #5FDCD4;
    --accent-soft: #163431;
    --good: #3fbf3f;
    --warning: #e0a542;
    --critical: #e07a72;
    --cat-1: #3987e5;
    --cat-2: #d95926;
    --cat-3: #199e70;
    --cat-4: #c98500;
    --cat-5: #d55181;
    --cat-6: #3fbf3f;
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px -12px rgba(0,0,0,0.5);
  }

  *{ box-sizing: border-box; }
  @media (prefers-reduced-motion: reduce){ *{ animation: none !important; transition: none !important; } }

  body{
    margin:0;
    background: var(--bg);
    color: var(--text);
    font-family: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.55;
  }
  h1,h2,h3{ font-family:"Manrope", system-ui, sans-serif; text-wrap: balance; margin:0; }
  .num{ font-family:"IBM Plex Mono", ui-monospace, monospace; font-variant-numeric: tabular-nums; }

  a{ color: var(--accent-strong); }

  .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 24px 80px; }

  .topbar{
    position: sticky; top:0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner{
    max-width: 1180px; margin:0 auto; padding: 14px 24px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
  }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand-mark{
    width:30px; height:30px; border-radius:8px;
    background: linear-gradient(155deg, var(--accent), var(--accent-strong));
    display:flex; align-items:center; justify-content:center;
    color:#fff; font-family:"Manrope"; font-weight:800; font-size:14px;
    flex-shrink:0;
  }
  .brand-text{ font-family:"Manrope"; font-weight:700; font-size:16px; letter-spacing:-0.01em; }

  .tabs{ display:flex; gap:4px; padding:3px; background: var(--surface-2); border-radius:10px; }
  .tab-btn{
    font-family:"Manrope"; font-size:13px; font-weight:700; color: var(--text-secondary);
    background: transparent; border:none; cursor:pointer; padding:7px 16px; border-radius:8px;
    transition: background .12s ease, color .12s ease;
  }
  .tab-btn:hover{ color: var(--text); }
  .tab-btn.active{ background: var(--surface); color: var(--accent-strong); box-shadow: var(--shadow); }
  .tab-panel[hidden]{ display:none; }

  header.hero{ padding: 40px 0 8px; }
  .eyebrow{
    font-family:"Manrope"; font-weight:700; font-size:12px; letter-spacing:.08em; text-transform:uppercase;
    color: var(--accent-strong); margin-bottom:10px; display:flex; align-items:center; gap:8px;
  }
  .eyebrow::before{ content:""; width:6px; height:6px; border-radius:50%; background: var(--accent); }
  h1.title{ font-size: clamp(28px,4vw,38px); font-weight:800; letter-spacing:-0.02em; max-width: 720px; }
  .subtitle{ color: var(--text-secondary); max-width:640px; margin-top:10px; font-size:15px; }
  .meta-row{
    display:flex; gap:18px; flex-wrap:wrap; margin-top:20px; font-size:13px; color: var(--text-muted);
  }
  .meta-row span{ display:flex; align-items:center; gap:6px; }
  .dot{ width:5px;height:5px;border-radius:50%;background:var(--text-muted); }

  section{ margin-top: 46px; scroll-margin-top: 74px; }
  .section-head{ display:flex; align-items:baseline; justify-content:space-between; gap:16px; margin-bottom:18px; flex-wrap:wrap; }
  .section-head h2{ font-size:20px; font-weight:800; letter-spacing:-0.01em; }
  .section-note{ font-size:13px; color: var(--text-muted); max-width:460px; text-align:right; }

  .card{
    background: var(--surface); border:1px solid var(--border); border-radius:14px;
    box-shadow: var(--shadow);
  }

  .kpi-grid{
    display:grid; grid-template-columns: repeat(6, 1fr); gap:1px;
    background: var(--border); border:1px solid var(--border); border-radius:14px; overflow:hidden;
    box-shadow: var(--shadow);
  }
  .kpi{ background: var(--surface); padding:18px 16px; min-width:0; }
  .kpi-label{ font-size:12px; color: var(--text-muted); font-weight:600; }
  .kpi-value{ font-size:24px; font-weight:700; margin-top:6px; letter-spacing:-0.02em; }
  .kpi-sub{ font-size:12px; color: var(--accent-strong); margin-top:4px; font-weight:600; }
  @media (max-width: 920px){ .kpi-grid{ grid-template-columns: repeat(3,1fr); } }
  @media (max-width: 560px){ .kpi-grid{ grid-template-columns: repeat(2,1fr); } }

  .funnel{ display:flex; align-items:stretch; gap:0; overflow-x:auto; padding-bottom:6px; }
  .funnel-stage{
    flex: 1 1 0; min-width:150px; background:var(--surface); border:1px solid var(--border);
    padding:16px 14px; position:relative; box-shadow: var(--shadow);
  }
  .funnel-stage:not(:first-child){ border-left:none; margin-left:-1px; }
  .funnel-stage:first-child{ border-radius:12px 0 0 12px; }
  .funnel-stage:last-child{ border-radius:0 12px 12px 0; }
  .funnel-stage .stage-name{ font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; }
  .funnel-stage .stage-value{ font-size:21px; font-weight:700; margin-top:8px; }
  .funnel-bar{ height:6px; border-radius:4px; background:var(--surface-2); margin-top:10px; overflow:hidden; }
  .funnel-bar > i{ display:block; height:100%; background: var(--accent); border-radius:4px; }
  .funnel-arrow{
    flex: 0 0 auto; width:26px; display:flex; align-items:center; justify-content:center;
    color: var(--text-muted); font-size:12px; font-weight:700; background: var(--surface-2);
    border-top:1px solid var(--border); border-bottom:1px solid var(--border); z-index:1;
  }

  .grid-2{ display:grid; grid-template-columns: 1.1fr 1fr; gap:20px; align-items:stretch; }
  @media (max-width: 880px){ .grid-2{ grid-template-columns: 1fr; } }
  .card-pad{ padding:22px 22px 20px; }
  .card-title{ font-size:14px; font-weight:700; margin-bottom:4px; }
  .card-desc{ font-size:12.5px; color:var(--text-muted); margin-bottom:16px; }

  .barrow{ display:grid; grid-template-columns: 150px 1fr auto; gap:10px; align-items:center; padding:7px 0; }
  .barrow .lbl{ font-size:12.5px; color:var(--text-secondary); font-weight:500; }
  .barrow .track{ height:16px; border-radius:5px; background:var(--surface-2); position:relative; overflow:hidden; }
  .barrow .fill{ position:absolute; inset:0 auto 0 0; border-radius:5px; }
  .barrow .val{ font-size:12.5px; font-weight:600; text-align:right; min-width:44px; }

  .legend{ display:flex; flex-wrap:wrap; gap:12px 16px; margin-top:14px; padding-top:14px; border-top:1px solid var(--border); }
  .legend-item{ display:flex; align-items:center; gap:7px; font-size:12px; color:var(--text-secondary); font-weight:500; }
  .swatch{ width:10px; height:10px; border-radius:3px; flex-shrink:0; }

  .table-wrap{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; font-size:13px; }
  thead th{
    text-align:left; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em;
    color:var(--text-muted); padding:10px 14px; border-bottom:1px solid var(--border); white-space:nowrap;
  }
  tbody td{ padding:10px 14px; border-bottom:1px solid var(--border); white-space:nowrap; }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr:hover td{ background: var(--surface-2); }
  td.num, th.num{ text-align:right; font-family:"IBM Plex Mono"; font-variant-numeric:tabular-nums; }
  .pill{
    display:inline-flex; align-items:center; gap:5px; font-size:11.5px; font-weight:700; padding:3px 8px;
    border-radius:99px; background: var(--accent-soft); color: var(--accent-strong);
  }
  .muted-cell{ color: var(--text-muted); }

  .breakdown-group{ border:1px solid var(--border); border-radius:12px; background:var(--surface); box-shadow: var(--shadow); overflow:hidden; }
  .breakdown-group + .breakdown-group{ margin-top:12px; }
  .bg-summary{
    list-style:none; cursor:pointer; padding:16px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px;
  }
  .bg-summary::-webkit-details-marker{ display:none; }
  .bg-left{ display:flex; align-items:center; gap:12px; min-width:0; }
  .bg-swatch{ width:10px; height:32px; border-radius:4px; flex-shrink:0; }
  .bg-title{ font-weight:700; font-size:14.5px; }
  .bg-count{ font-size:12.5px; color:var(--text-muted); margin-top:2px; }
  .bg-right{ display:flex; align-items:center; gap:14px; flex-shrink:0; }
  .bg-share{ font-weight:700; font-size:16px; }
  .chev{ transition: transform .15s ease; color: var(--text-muted); }
  details[open] .chev{ transform: rotate(180deg); }
  .bg-body{ padding: 0 20px 18px; }

  .voc-callout{
    display:flex; gap:12px; align-items:flex-start; padding:14px 18px; margin-bottom:14px;
    border:1px solid var(--border); border-radius:12px; background:var(--surface-2);
    font-size:12.5px; color:var(--text-secondary);
  }
  .voc-callout b{ color:var(--text); }
  .voc-takeaway{
    font-size:13px; color:var(--text-secondary); background:var(--accent-soft); color:var(--accent-strong);
    border-radius:8px; padding:10px 14px; margin-bottom:16px; font-weight:600;
  }
  .voc-cat + .voc-cat{ margin-top:16px; }
  .voc-cat-head{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:6px; }
  .voc-cat-name{ font-size:13px; font-weight:700; }
  .voc-cat-stat{ font-size:12px; color:var(--text-muted); flex-shrink:0; }
  .voc-samples{ list-style:none; margin:10px 0 0; padding:0; display:flex; flex-direction:column; gap:6px; }
  .voc-samples li{
    font-size:12.5px; color:var(--text-secondary); font-style:italic; line-height:1.5;
    padding-left:14px; border-left:2px solid var(--border);
  }

  footer{ margin-top:60px; padding-top:24px; border-top:1px solid var(--border); }
  footer p{ font-size:12.5px; color:var(--text-muted); max-width:820px; }
  footer strong{ color: var(--text-secondary); }
</style>

<div class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark">DR</div>
      <div class="brand-text">Drop-off Recovery Desk</div>
    </div>
    <nav class="tabs" role="tablist">
      <button class="tab-btn active" type="button" role="tab" aria-selected="true" data-tab="summary">Executive Summary</button>
      <button class="tab-btn" type="button" role="tab" aria-selected="false" data-tab="voc">VOC</button>
    </nav>
  </div>
</div>

<div class="wrap">

  <header class="hero">
    <div class="eyebrow">App drop-off calling · Executive summary</div>
    <h1 class="title">Where app drop-offs stall, and why they don't book.</h1>
    <p class="subtitle">Every figure below is computed straight from <strong>CALL SHEET – APP Drop offs</strong> using the same aggregation logic as the <strong>Executive Summary – APP Dropoffs</strong> tab: COUNTUNIQUE / COUNTIFS for volumes, and MEDIAN/AVERAGE/PERCENTILE for decision-day timing — reorganised into one page.</p>
    <div class="meta-row">
      <span><span class="dot"></span>Source: {{ source_name }} → CALL SHEET – APP Drop offs ({{ "{:,}".format(row_count) }} rows)</span>
      <span><span class="dot"></span>Snapshot taken {{ snapshot_date }}</span>
      <span><span class="dot"></span>Auto-refreshed daily from the live sheet</span>
    </div>
  </header>

  <div class="tab-panel" id="tab-summary">

  <section id="funnel">
    <div class="section-head">
      <h2>Calling funnel</h2>
      <div class="section-note">Leads → attempted → connected → meaningfully connected → interested → booked.</div>
    </div>

    <div class="kpi-grid">
      <div class="kpi">
        <div class="kpi-label">Total leads</div>
        <div class="kpi-value num">{{ "{:,}".format(f.total_leads) }}</div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Unique attempts</div>
        <div class="kpi-value num">{{ "{:,}".format(f.unique_attempts) }}</div>
        <div class="kpi-sub">{{ f.attempts_pct }}% of leads</div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Connected</div>
        <div class="kpi-value num">{{ "{:,}".format(f.connected) }}</div>
        <div class="kpi-sub">{{ f.connect_pct }}% connect rate</div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Meaningful connect</div>
        <div class="kpi-value num">{{ "{:,}".format(f.meaningful_connect) }}</div>
        <div class="kpi-sub">{{ f.mc_pct }}% of connected</div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Interested</div>
        <div class="kpi-value num">{{ "{:,}".format(f.interested) }}</div>
        <div class="kpi-sub">{{ f.interest_pct }}% of connects</div>
      </div>
      <div class="kpi">
        <div class="kpi-label">Booked</div>
        <div class="kpi-value num">{{ "{:,}".format(f.booked) }}</div>
        <div class="kpi-sub">{{ f.booked_pct }}% of leads</div>
      </div>
    </div>

    <div class="funnel" style="margin-top:20px;" aria-hidden="true">
      <div class="funnel-stage" style="border-radius:12px 0 0 12px;">
        <div class="stage-name">Leads</div>
        <div class="stage-value num">{{ "{:,}".format(f.total_leads) }}</div>
        <div class="funnel-bar"><i style="width:100%"></i></div>
      </div>
      <div class="funnel-arrow">{{ f.arrow1 }}%</div>
      <div class="funnel-stage">
        <div class="stage-name">Attempted</div>
        <div class="stage-value num">{{ "{:,}".format(f.unique_attempts) }}</div>
        <div class="funnel-bar"><i style="width:{{ f.w_attempts }}%"></i></div>
      </div>
      <div class="funnel-arrow">{{ f.arrow2 }}%</div>
      <div class="funnel-stage">
        <div class="stage-name">Connected</div>
        <div class="stage-value num">{{ "{:,}".format(f.connected) }}</div>
        <div class="funnel-bar"><i style="width:{{ f.w_connected }}%"></i></div>
      </div>
      <div class="funnel-arrow">{{ f.arrow3 }}%</div>
      <div class="funnel-stage">
        <div class="stage-name">Meaningful connect</div>
        <div class="stage-value num">{{ "{:,}".format(f.meaningful_connect) }}</div>
        <div class="funnel-bar"><i style="width:{{ f.w_mc }}%"></i></div>
      </div>
      <div class="funnel-arrow">{{ f.arrow4 }}%</div>
      <div class="funnel-stage">
        <div class="stage-name">Interested</div>
        <div class="stage-value num">{{ "{:,}".format(f.interested) }}</div>
        <div class="funnel-bar"><i style="width:{{ f.w_interested }}%"></i></div>
      </div>
      <div class="funnel-arrow">{{ f.arrow5 }}%</div>
      <div class="funnel-stage" style="border-radius:0 12px 12px 0;">
        <div class="stage-name">Booked</div>
        <div class="stage-value num">{{ "{:,}".format(f.booked) }}</div>
        <div class="funnel-bar"><i style="width:{{ f.w_booked }}%"></i></div>
      </div>
    </div>

    <div class="card card-pad" style="margin-top:18px;">
      <div class="card-title">Follow-up cohort — leads with a decision date on file</div>
      <div class="card-desc">Subset of leads where the agent captured a firm "come back to me on…" date (Decision date column populated).</div>
      <div class="kpi-grid" style="grid-template-columns:repeat(5,1fr); background:transparent; border:none; box-shadow:none;">
        <div class="kpi" style="border:1px solid var(--border); border-radius:10px;">
          <div class="kpi-label">Leads</div>
          <div class="kpi-value num" style="font-size:20px;">{{ "{:,}".format(fu.leads) }}</div>
        </div>
        <div class="kpi" style="border:1px solid var(--border); border-radius:10px;">
          <div class="kpi-label">Unique attempts %</div>
          <div class="kpi-value num" style="font-size:20px;">{{ fu.attempts_pct }}%</div>
        </div>
        <div class="kpi" style="border:1px solid var(--border); border-radius:10px;">
          <div class="kpi-label">Meaningful connect</div>
          <div class="kpi-value num" style="font-size:20px;">{{ "{:,}".format(fu.mc) }}</div>
        </div>
        <div class="kpi" style="border:1px solid var(--border); border-radius:10px;">
          <div class="kpi-label">Connect %</div>
          <div class="kpi-value num" style="font-size:20px;">{{ fu.connect_pct }}%</div>
        </div>
        <div class="kpi" style="border:1px solid var(--border); border-radius:10px;">
          <div class="kpi-label">Already booked %</div>
          <div class="kpi-value num" style="font-size:20px; color:var(--good);">{{ fu.booked_pct }}%</div>
        </div>
      </div>
    </div>
  </section>

  <section id="outcomes">
    <div class="section-head">
      <h2>Outcomes &amp; top reasons</h2>
      <div class="section-note">Intent bucket sizes, and the single biggest reasons customers don't book.</div>
    </div>
    <div class="grid-2">
      <div class="card card-pad">
        <div class="card-title">Intent distribution (bifurcation)</div>
        <div class="card-desc">Every lead's final intent tag, from CALL SHEET column A — total leads vs. how many still booked anyway.</div>

        {% for c in intent_categories %}
        <div class="barrow">
          <div class="lbl">{{ c.name }}</div>
          <div class="track"><div class="fill" style="width:{{ c.width }}%; background:var(--{{ c.color }});"></div></div>
          <div class="val num">{{ "{:,}".format(c.total) }}</div>
        </div>
        {% endfor %}

        <div class="legend">
          {% for c in intent_categories %}
          <div class="legend-item"><span class="swatch" style="background:var(--{{ c.color }})"></span>{{ c.name }} · {{ c.booked }} booked{{ ' anyway' if c.name == "Wouldn't" else '' }}</div>
          {% endfor %}
        </div>
      </div>

      <div class="card card-pad" id="reasons">
        <div class="card-title">Top 5 reasons customers don't book</div>
        <div class="card-desc">Share of meaningful-connect calls ({{ "{:,}".format(f.meaningful_connect) }}) citing each reason, "Others" excluded.</div>

        {% for r in top5 %}
        <div class="barrow">
          <div class="lbl">{{ r.label }}</div>
          <div class="track"><div class="fill" style="width:{{ r.width }}%; background:var(--accent);"></div></div>
          <div class="val num">{{ r.pct }}%</div>
        </div>
        {% endfor %}

        <div class="legend">
          <div class="legend-item">These 5 reasons alone account for <strong style="color:var(--text)">&nbsp;{{ top5_sum }}%&nbsp;</strong> of every meaningful-connect call.</div>
        </div>
      </div>
    </div>
  </section>

  <section id="decision">
    <div class="section-head">
      <h2>How long until they decide?</h2>
      <div class="section-note">Gap between call date and the decision date the customer gave, by interest bucket.</div>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Interest bucket</th>
              <th class="num">Customers</th>
              <th class="num">Median days</th>
              <th class="num">Avg days</th>
              <th class="num">P90</th>
              <th class="num">P95</th>
            </tr>
          </thead>
          <tbody>
            {% for b in decision_buckets %}
            <tr>
              <td>{% if b.pill %}<span class="pill">{{ b.label }}</span>{% else %}{{ b.label }}{% endif %}</td>
              <td class="num">{{ "{:,}".format(b.n) }}</td>
              <td class="num {{ '' if b.pill else 'muted-cell' }}">{{ b.median }}</td>
              <td class="num {{ '' if b.pill else 'muted-cell' }}">{{ b.avg }}</td>
              <td class="num {{ '' if b.pill else 'muted-cell' }}">{{ b.p90 }}</td>
              <td class="num {{ '' if b.pill else 'muted-cell' }}">{{ b.p95 }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="breakdown">
    <div class="section-head">
      <h2>Full reason breakdown, by outcome</h2>
      <div class="section-note">Same pivot as Executive Summary: every logged reason grouped under its outcome bucket, ranked by count. Share is of the {{ "{:,}".format(grand_total) }} outcome-tagged calls.</div>
    </div>

    {% for g in breakdown_groups %}
    <details class="breakdown-group"{{ ' open' if loop.first else '' }}>
      <summary class="bg-summary">
        <div class="bg-left">
          <div class="bg-swatch" style="background:var(--{{ g.color }})"></div>
          <div>
            <div class="bg-title">{{ g.name }}</div>
            <div class="bg-count">{{ g.reasons|length }} reason{{ 's' if g.reasons|length != 1 else '' }} logged · {{ "{:,}".format(g.total) }} calls</div>
          </div>
        </div>
        <div class="bg-right">
          <div class="bg-share num">{{ g.share }}%</div>
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </summary>
      <div class="bg-body">
        <div class="table-wrap">
          <table>
            <thead><tr><th>Reason</th><th class="num">Count</th><th class="num">% of total</th></tr></thead>
            <tbody>
              {% for r in g.reasons %}
              <tr><td>{{ r.label }}</td><td class="num">{{ "{:,}".format(r.count) }}</td><td class="num">{{ r.pct }}%</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {% endfor %}

    <div class="card card-pad" style="margin-top:14px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
      <div class="card-title" style="margin:0;">Grand total (outcome-tagged calls)</div>
      <div class="num" style="font-size:20px; font-weight:700;">{{ "{:,}".format(grand_total) }}</div>
    </div>
  </section>

  </div>

  <div class="tab-panel" id="tab-voc" hidden>

  <section id="voc">
    <div class="section-head">
      <h2>Voice of the customer</h2>
      <div class="section-note">What customers actually said, in their own words, grouped into themes for the top reasons.</div>
    </div>

    <div class="voc-callout">
      <span>💬</span>
      <span><b>How this is different from the rest of this page:</b> every other section here is a deterministic count straight off the sheet. This section reads the free-text comment agents leave per call ("What EXACTLY are they waiting for") and sorts it into themes using keyword rules — the same theme taxonomy the source sheet's own VOC tab uses, re-applied to current data. It's a best-effort classification, not an exact formula, so treat these shares as directional.</span>
    </div>

    {% for g in voc_groups %}
    <details class="breakdown-group">
      <summary class="bg-summary">
        <div class="bg-left">
          <div class="bg-swatch" style="background:var(--accent)"></div>
          <div>
            <div class="bg-title">{{ g.title }}</div>
            <div class="bg-count">{{ "{:,}".format(g.total) }} comments read · top theme: {{ g.categories[0].name }}</div>
          </div>
        </div>
        <div class="bg-right">
          <div class="bg-share num">{{ g.categories[0].pct }}%</div>
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
        </div>
      </summary>
      <div class="bg-body">
        <div class="voc-takeaway">{{ g.takeaway }}</div>
        {% for c in g.categories %}
        <div class="voc-cat">
          <div class="voc-cat-head">
            <span class="voc-cat-name">{{ c.name }}</span>
            <span class="voc-cat-stat num">{{ "{:,}".format(c.count) }} · {{ c.pct }}%</span>
          </div>
          <div class="track"><div class="fill" style="width:{{ c.pct }}%; background:var(--accent);"></div></div>
          {% if c.samples %}
          <ul class="voc-samples">
            {% for s in c.samples %}
            <li>"{{ s }}"</li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </section>

  </div>

  <footer>
    <p><strong>Methodology.</strong> Total Leads = COUNTUNIQUE of phone numbers; Unique Attempts = non-blank call-time entries; Connected = Connect Status starting "Connected"; Meaningful Connect = Connect Status exactly "Connected – spoke to customer"; Interested = Interest Bucket in either "Interested – Not Yet" state; Booked = booking flag = 1 on a connected call. Reason and outcome tables group each logged primary-reason code under its mapped outcome bucket (Wouldn't / Not Yet / Couldn't / Existing Wiom / Already Booked / Unknown), identical to the mapping used in the source sheet's DAILY SUMMARY tab. All text matching is case-insensitive, matching Google Sheets' COUNTIF/COUNTIFS behaviour — several fields (Connect Status, Interest Bucket) carry mixed-case duplicates in the raw data that are folded together here exactly as they are on the live sheet.</p>
    <p style="margin-top:10px;">Rebuilt automatically once a day from <strong>CALL SHEET – APP Drop offs</strong> in Wiom_Dropoff_Calling_Pack_03Sep2026. Numbers reflect the sheet as of the snapshot time above, not the exact moment you're viewing this page.</p>
  </footer>

</div>

<script>
  document.querySelectorAll('.tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.tab-btn').forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.tab-panel').forEach(function (p) {
        p.hidden = true;
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.getElementById('tab-' + btn.dataset.tab).hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
